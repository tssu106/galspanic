{
  "name": "galspanic-server",
  "version": "0.1.0",
  "description": "Co-op grid reveal game server (Colyseus)",
  "main": "dist/index.js",
  "scripts": {
    "prestart": "npm run build:sim",
    "start": "ts-node src/index.ts",
    "build:sim": "esbuild src/GalSim.ts --bundle --format=esm --platform=browser --outfile=../client/sim.bundle.js",
    "build": "npm run build:sim && tsc",
    "serve": "node dist/index.js",
    "prod": "npm run build && NODE_ENV=production node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@colyseus/core": "^0.15.0",
    "@colyseus/schema": "^2.0.0",
    "@colyseus/ws-transport": "^0.15.0",
    "colyseus": "^0.15.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
