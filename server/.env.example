# 이 파일을 복사해서 server/.env 로 만들고 값을 채우세요 (server/.env 는 gitignore 됩니다).
#   cp server/.env.example server/.env
#
# ⚠️ service_role 키는 비밀키입니다. 절대 커밋·채팅 공유·클라이언트 노출 금지.
#    Supabase → Settings → API → "service_role" (secret) 키를 복사해 아래에 넣으세요.
SUPABASE_SERVICE_ROLE=

# (선택) 다른 프로젝트면 URL 도 지정. 기본값은 코드에 하드코딩돼 있어 보통 불필요.
# SUPABASE_URL=https://qtrcoicleczgdtbtnvyu.supabase.co
